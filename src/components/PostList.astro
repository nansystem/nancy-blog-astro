---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map(post => <li>
    <div class="meta"><FormattedDate date={post.data.date} />{post.data.published === false && <span class="badge">下書き</span>}
      {post.data.categories.map(category => <a href={`/category/${encodeURIComponent(category.toLowerCase())}`}>{category}</a>)}
    </div>
    <h2><a href={post.data.permalink}>{post.data.title}</a></h2>
    {post.data.description && <p>{post.data.description}</p>}
  </li>)}
</ul>
<style>
.post-list { padding: 0; margin: 0; list-style: none; }
li { padding: 1.8rem 0; border-bottom: 1px solid rgb(var(--border)); margin: 0; }
.meta { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .8rem; color: rgb(var(--gray)); font-size: .75rem; }
.meta a { color: var(--accent); }
h2 { margin: .6rem 0; padding: 0; border: 0; font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.65; }
h2 a { color: rgb(var(--black)); }
h2 a:hover { color: var(--accent); }
p { color: rgb(var(--gray)); font-size: .875rem; margin: .5rem 0 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.badge { padding: .1rem .4rem; background: #fff0ce; color: #765200; border-radius: 3px; }
</style>
