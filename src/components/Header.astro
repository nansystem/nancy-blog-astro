---
import { SITE_TITLE } from '../consts';
const topics = ['React', 'JavaScript', 'Python', 'Google Cloud'];
const pathname = decodeURIComponent(Astro.url.pathname).replace(/\/$/, '');
---
<header>
  <nav aria-label="メインナビゲーション">
    <a class="site-title" href="/"><span class="brand-mark" aria-hidden="true">n.</span>{SITE_TITLE}<span class="subtitle">技術と、試行錯誤の記録。</span></a>
    <div class="nav-links">
      <a href="/" aria-current={pathname === '' ? 'page' : undefined}>記事一覧</a>
      {topics.map(topic => <a href={`/category/${encodeURIComponent(topic.toLowerCase())}`} aria-current={pathname === `/category/${topic.toLowerCase()}` ? 'page' : undefined}>{topic}</a>)}
      <a href="/rss.xml">RSS</a>
    </div>
  </nav>
</header>
<style>
header { border-bottom: 1px solid rgb(var(--border)); }
nav { max-width: 1060px; margin: auto; padding: 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
.site-title { display: flex; align-items: center; gap: .65rem; color: rgb(var(--black)); font-weight: 750; font-size: 1.15rem; text-decoration: none; }
.brand-mark { background: var(--accent); color: white; width: 2rem; height: 2rem; border-radius: 7px; display: grid; place-items: center; font-family: Georgia, serif; }
.subtitle { display: none; }
.nav-links { display: flex; flex-wrap: wrap; gap: .4rem 1rem; }
.nav-links a { font-size: .8rem; color: rgb(var(--gray)); padding: .3rem 0; }
.nav-links a[aria-current] { color: var(--accent); text-decoration: underline; text-underline-offset: .5rem; }
@media(max-width: 760px) { nav { flex-direction: column; align-items: flex-start; gap: 1rem; padding: 1rem; } .subtitle { display: inline; font-size: .7rem; font-weight: 400; } }
</style>
