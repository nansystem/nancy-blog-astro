---
const today = new Date();
---
<footer>
  <a href="/">nansystem</a>
  <small>&copy; {today.getFullYear()} nansystem</small>
</footer>
<style>
footer { max-width: 1012px; margin: 3rem auto 0; padding: 2rem 1rem 3rem; border-top: 1px solid rgb(var(--border)); display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; color: rgb(var(--gray)); font-size: .85rem; }
footer a { color: rgb(var(--black)); font-weight: 700; }
small { margin-left: auto; }
</style>
